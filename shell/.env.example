# shell/.env.example — every config key (shell/ARCHITECTURE.md contract).
# Copy to shell/.env and fill in real values. EVERY key is optional: with no
# keys at all the shell runs fully mocked (DEV_BYPASS auto-on). Secrets live
# in VPS env vars / this file only — never in the repo or the image.

# --- mode -------------------------------------------------------------------
# dev | staging | prod. staging/prod turn ON response minimization (minimize.py).
ENV=dev
# Force the mock identity on/off. UNSET = auto: bypass is ON exactly when
# CLERK_SECRET_KEY is empty. Never set to 1 in prod.
#DEV_BYPASS=1
# Public origin of this deployment; used for azp checks + redirect_url.
BASE_URL=http://localhost:8200

# --- Clerk (auth) -----------------------------------------------------------
# From the Clerk dashboard (dev instance for staging, prod instance for prod).
#CLERK_PUBLISHABLE_KEY=pk_test_...
#CLERK_SECRET_KEY=sk_test_...
# Usually unnecessary: derived from the publishable key if unset.
#CLERK_JWKS_URL=https://<frontend-api>/.well-known/jwks.json

# --- Supabase Postgres (data only; identity lives in Clerk) -----------------
#SUPABASE_URL=https://<project>.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Direct Postgres DSN for asyncpg (Supabase → Settings → Database).
#DATABASE_URL=postgresql://postgres:...@db.<project>.supabase.co:5432/postgres

# --- Stripe -----------------------------------------------------------------
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_ID_PRO=price_...

# --- OCR (vision-LLM; paid tier only) ---------------------------------------
#ANTHROPIC_API_KEY=sk-ant-...
#GEMINI_API_KEY=...
# 1 = canned OCR fixtures, no API calls (default; tests run with this).
OCR_MOCK=1

# --- production limits (defaults shown; entitlements table overrides quotas) -
MIN_TROOPS_PER_SIDE=5000
FREE_SIMS_PER_DAY=5
PRO_SIMS_PER_DAY=100
PRO_OCR_PER_DAY=30
BURST_PER_MIN=5
GLOBAL_CONCURRENCY=8
